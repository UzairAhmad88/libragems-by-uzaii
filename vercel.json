{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm --prefix apps/web install",
  "buildCommand": "npm --prefix apps/web run build",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/cron/process-outbox",
      "schedule": "*/5 * * * *"
    }
  ]
}

